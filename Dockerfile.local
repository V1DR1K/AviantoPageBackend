FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml ./
COPY src ./src
RUN mvn -B -DskipTests package

FROM eclipse-temurin:21-jre-alpine AS layers
WORKDIR /build
COPY --from=build /workspace/target/avianto-landing-1.0.0.jar app.jar
RUN java -Djarmode=tools -jar app.jar extract --layers --destination /layers

FROM eclipse-temurin:21-jre-alpine
RUN apk add --no-cache fontconfig libwebp-tools
WORKDIR /app
COPY --from=layers /layers/dependencies/ ./
COPY --from=layers /layers/spring-boot-loader/ ./
COPY --from=layers /layers/snapshot-dependencies/ ./
COPY --from=layers /layers/application/ ./
USER 10001:10001
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=65.0 -XX:InitialRAMPercentage=15.0 -Djava.awt.headless=true"
EXPOSE 8084
ENTRYPOINT ["java", "-jar", "app.jar"]
